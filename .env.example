# ==========================================
# TransferGuard Platform Environment Variables
# ==========================================

# Server Configuration
NODE_ENV=production
PORT=3001

# AI / Ollama Configuration (Optional)
# If Ollama is running, specify host & model. If omitted, local heuristic parsing is used.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Frontend Cross-Domain API URL (Only needed if web is hosted separately from API)
# VITE_API_URL=https://api.yourdomain.com
